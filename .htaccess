#<ifModule mod_deflate.c>
#    AddOutputFilterByType DEFLATE text/html text/plain text/xml application/xml application/xhtml+xml text/css text/javascript application/javascript application/x-javascript
#</ifModule>

# Options FollowSymLinks
AddDefaultCharset utf-8

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Видаємо окремі версії robots.txt для кожного піддомену без редіректів на HTTPS,
    # щоб у пошукових систем залишалося коректне посилання на відповідний sitemap.
    # Прапор [END] завершує обробку mod_rewrite, тож Yii не перехоплює статичний robots-файл.
    # Захоплюємо код локалі в змінну %1, щоб уникнути дублювання правил.
    RewriteCond %{REQUEST_URI} ^/robots\.txt$ [NC]
    # Новий піддомен NZ має окремий robots.txt із забороною індексації.
    RewriteCond %{HTTP_HOST} ^(en|ru|ua|no|nz)\.referendum\.social$ [NC]
    RewriteRule ^robots\.txt$ robots/robots.%1.txt [L,END]

    # Основний домен віддає стандартний robots.txt без примусового редіректу на HTTPS.
    RewriteCond %{REQUEST_URI} ^/robots\.txt$ [NC]
    RewriteRule ^ - [L]

    RewriteRule ^xadmin/plugins/(.*)$ backend/web/plugins/$1 [L]
    RewriteRule ^data/(.*)$ frontend/web/data/$1 [L]
    RewriteRule ^thumbs/(.*)$ frontend/web/thumbs/$1 [L]

    #SITEMAPS:

    # Схожі правила для sitemap-ів поєднуємо в одне, щоб легше було додавати нові локалі.
    RewriteCond %{HTTP_HOST} ^(en|ru|ua|no)\.referendum\.social$ [NC]
    RewriteRule ^poll-sitemap\.xml$ sitemaps/%1.poll.xml [L]

    RewriteCond %{HTTP_HOST} ^(en|ru|ua|no)\.referendum\.social$ [NC]
    RewriteRule ^tags-sitemap\.xml$ sitemaps/%1.tags.xml [L]

    RewriteCond %{HTTP_HOST} ^(en|ru|ua|no)\.referendum\.social$ [NC]
    RewriteRule ^sitemap\.xml$ sitemaps/%1.index.xml [L]


    RewriteCond %{HTTP_HOST} ^referendum\.social$
    RewriteRule ^sitemap\.xml$ sitemaps/index.xml

    RewriteRule ^search/tag/(.*)$ /tag/$1 [R=301,L]

   # /SITEMAPS.

    # the main rewrite rule for the frontend application
    # # Base:
    # # RewriteCond %{REQUEST_URI} !^/(backend/web|xadmin)
    # # NOt call Yii2
    RewriteCond %{REQUEST_URI} !^/(backend/web|xadmin|sitemap)
    RewriteCond %{REQUEST_URI} !^(.*)sitemap.xml$
    RewriteRule !^frontend/web /frontend/web%{REQUEST_URI} [L]

    # redirect to the page without a trailing slash (uncomment if necessary)
    #RewriteCond %{REQUEST_URI} ^/xadmin/$
    #RewriteRule ^(xadmin)/ /$1 [L,R=301]
    # the main rewrite rule for the backend application
    RewriteCond %{REQUEST_URI} ^/xadmin
    RewriteRule ^xadmin(.*) /backend/web/$1 [L]

#RewriteCond %{REQUEST_FILENAME} !-f
#RewriteCond %{REQUEST_URI} /+[^\.]+$
#RewriteRule ^(.*[^/])$ $1/ [L,R=301]

    # if a directory or a file of the frontend application exists, use the request directly
    RewriteCond %{REQUEST_URI} ^/frontend/web
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    # otherwise forward the request to index.php
    RewriteRule . /frontend/web/index.php [L]

    # if a directory or a file of the backend application exists, use the request directly
    RewriteCond %{REQUEST_URI} ^/backend/web
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    # otherwise forward the request to index.php
    RewriteRule . /backend/web/index.php [L]

    RewriteCond %{REQUEST_URI} \.(htaccess|htpasswd|svn|git)
    RewriteRule \.(htaccess|htpasswd|svn|git) - [F]
</IfModule>

Redirect 301 /poll/view/382 https://en.referendum.social/
